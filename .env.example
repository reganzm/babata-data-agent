# === LLM ===
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o
MODEL_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# P4：按 Agent 覆盖模型名（未设则用 MODEL_NAME）
# MODEL_BABATA=
# MODEL_XIMO=
# MODEL_CHESTNUT=
# 混沌专用模型名，未设置时回退 MODEL_NAME
# MODEL_HUNDUN=

# === 登录（用户表 babata_users 在 storage.db 同库）===
# 未设置 SECRET 时开发环境用内置占位密钥；生产必须设置
BABATA_AUTH_SECRET=请填写随机长字符串
# BABATA_AUTH_SESSION_DAYS=7
# 本地开发可关闭鉴权: BABATA_AUTH_DISABLED=true
# 创建用户: pnpm user:create <用户名> <密码>
# 修改密码: pnpm user:chpwd <用户名> <新密码>

# === Babata 会话 / Mastra Memory（本地 SQLite，与数仓无关）===
BABATA_STORAGE_URL=file:./storage.db
BABATA_RESOURCE_ID=babata-local-user

# === 西莫 & Workflow 分析库（Doris 数仓，仅 SELECT）===
# 方式一（推荐）：MySQL 协议连接串（Doris FE 默认端口 9030；密码含 @ 请 URL 编码为 %40）
# DORIS_DSN=mysql://用户名:密码@fe-host:9030/数据库名
# DORIS_URL=mysql://用户名:密码@fe-host:9030/数据库名
# DATABASE_URL=mysql://用户名:密码@fe-host:9030/数据库名

# 方式二：分项配置
# DORIS_HOST=fe-host.example.com
# DORIS_PORT=9030
# DORIS_USER=your_user
# DORIS_PASSWORD=your_password
# DORIS_DATABASE=your_db
# DORIS_POOL_SIZE=5

# SQL 安全（execute-readonly-sql 仅允许 SELECT，自动追加 LIMIT）
# SQL_TABLE_ALLOWLIST=table_a,table_b
# SQL_MAX_ROWS=1000
# SQL_TIMEOUT_MS=60000

# 元数据本地缓存（storage.db，先读缓存再查 Doris；默认 TTL 24h）
# DORIS_METADATA_CACHE=false
# DORIS_METADATA_CACHE_TTL_MS=86400000

# 周报 Workflow 指定表（未设则取 list-tables 第一张）
# WEEKLY_METRICS_TABLE=your_table

# === Workflow（P3）===
# BABATA_WORKFLOW_SKIP_HITL=true

# === 委派上下文（P4）===
# MEMORY_LAST_MESSAGES=20
# INCLUDE_SUBAGENT_TOOLS_IN_CONTEXT=true

# === Agent Skills（P6）===
# 是否启用 Mastra Agent Skills（false 时不创建 Agent 专属 skill workspace）
# AGENT_SKILLS_ENABLED=true
# Agent Skills 根目录，默认使用项目根目录下 workspace
# AGENT_SKILLS_ROOT=workspace
# 是否动态重新发现 skill 目录（开发环境建议 true，生产环境建议 false）
# AGENT_SKILLS_DYNAMIC_DISCOVERY=true

# === 混沌上下文支撑智能体（Hundun）===
# 混沌可读取的数仓源码根目录，多个目录用英文逗号分隔；留空时源码探查工具返回未配置
# HUNDUN_SOURCE_ROOTS=
# 混沌源码检索允许的文件扩展名，多个扩展名用英文逗号分隔
# HUNDUN_SOURCE_EXTENSIONS=.sql,.hql,.md,.yaml,.yml,.ts,.tsx
# 混沌单次源码搜索最多返回的命中条数
# HUNDUN_SOURCE_SEARCH_LIMIT=20
# 混沌源码搜索后端，auto 优先使用本地 ripgrep，未安装时降级为 TypeScript；可选 auto/ripgrep/typescript
# HUNDUN_SOURCE_SEARCH_BACKEND=auto
# 混沌单次源码读取最多返回的字符数
# HUNDUN_SOURCE_READ_MAX_CHARS=12000
# 混沌 RAG 知识库查询接口地址，留空表示未配置
# HUNDUN_RAG_ENDPOINT=
# 混沌数据血缘查询接口地址，填写带 p= 的查询前缀，表名会自动追加并进行 URL 编码
# HUNDUN_LINEAGE_ENDPOINT=http://10.112.33.203:3000/blood?p=
