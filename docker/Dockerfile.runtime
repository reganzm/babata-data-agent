# 仅打包已构建产物，构建阶段不执行 node / pnpm。
# 适用：目标机 docker build 时 Node 报 uv_thread_create / Aborted。
#
# 在能正常跑 pnpm 的机器上：
#   pnpm install && pnpm build
#   bash scripts/docker-package-runtime.sh
#   docker build -f docker/Dockerfile.runtime -t babata:test docker/context
#
# 将 babata.tar 拷到服务器后：docker load -i babata.tar

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV BABATA_STORAGE_URL=file:/app/data/storage.db

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 --ingroup nodejs nextjs \
  && mkdir -p /app/data /app/config /app/config.defaults \
  && chown -R nextjs:nodejs /app

COPY --chown=nextjs:nodejs standalone ./
COPY --chown=nextjs:nodejs static ./.next/static
# context 里 public/ 可能为空目录（无静态资源时）
COPY --chown=nextjs:nodejs public ./public
COPY config/.env.example /app/config.defaults/.env.example
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3000
VOLUME ["/app/data", "/app/config"]
ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", "server.js"]
