# 兼容 Docker 1.13 等旧版本（不支持 FROM ... AS 多阶段构建）
# 用法: docker build -f Dockerfile.legacy -t babata:test .
#
# 更推荐升级 Docker 20.10+ 后使用主 Dockerfile:
#   docker build -t babata:test .

FROM node:22-bookworm-slim
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV BABATA_STORAGE_URL=file:/app/data/storage.db
ENV NPM_REGISTRY=https://registry.npmjs.org

RUN npm install -g pnpm@9.15.4 --registry="${NPM_REGISTRY}" \
  && pnpm --version \
  && addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 --ingroup nodejs nextjs \
  && mkdir -p /app/data /app/config

COPY package.json pnpm-lock.yaml ./
RUN pnpm config set registry "${NPM_REGISTRY}" \
  && pnpm install --frozen-lockfile

COPY . .
RUN mkdir -p public && touch public/.keep \
  && pnpm build \
  && mkdir -p /tmp/babata-out/.next \
  && cp -a .next/standalone/. /tmp/babata-out/ \
  && cp -a .next/static /tmp/babata-out/.next/static \
  && cp -a public /tmp/babata-out/public \
  && rm -rf /app/* /app/.[!.]* /app/..?* 2>/dev/null || true \
  && cp -a /tmp/babata-out/. /app/ \
  && rm -rf /tmp/babata-out \
  && chown -R nextjs:nodejs /app

COPY .env.example /app/config.defaults/.env.example
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3000
VOLUME ["/app/data", "/app/config"]
ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", "server.js"]
